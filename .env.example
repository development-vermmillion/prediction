# Server
PORT=3000
# SQLite file location (default: ./data/predicators.db)
# DATABASE_PATH=./data/predicators.db

# Owner account, created on first start if no owner exists.
# In production ADMIN_PASSWORD (min 10 chars) is REQUIRED.
ADMIN_EMAIL=admin@predicators.com
ADMIN_PASSWORD=change-me-please

# Set to 1 only when serving production over plain http (e.g. local testing)
# INSECURE_COOKIES=1

NEXT_PUBLIC_SITE_NAME=Predicators
